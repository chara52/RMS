# ========================================
# MicroCMS Settings
# ========================================
VITE_MICROCMS_SERVICE_DOMAIN=your_microcms_service_domain   
VITE_API_KEY=your_microcms_api_key                           

# Shift Management (MicroCMS) Settings
# ========================================
VITE_SHIFT_DOMAIN=your_shift_microcms_domain                 
VITE_SHIFT_API_KEY=your_shift_microcms_api_key               

# ========================================
# Firebase Admin SDK Credentials
# (These values should NEVER be exposed to client-side)
# ========================================
MY_FIREBASE_TYPE=service_account                             
MY_FIREBASE_PROJECT_ID=your_firebase_project_id              
MY_FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id     
MY_FIREBASE_PRIVATE_KEY="your_firebase_private_key"         
MY_FIREBASE_CLIENT_EMAIL=your_firebase_client_email          
MY_FIREBASE_CLIENT_ID=your_firebase_client_id                
MY_FIREBASE_AUTH_URI=your_firebase_auth_uri                  
MY_FIREBASE_TOKEN_URI=your_firebase_token_uri               
MY_FIREBASE_AUTH_PROVIDER_X509_CERT_URL=your_auth_provider_cert_url
MY_FIREBASE_CLIENT_X509_CERT_URL=your_client_cert_url
MY_FIREBASE_UNIVERSE_DOMAIN=your_firebase_universe_domain    
